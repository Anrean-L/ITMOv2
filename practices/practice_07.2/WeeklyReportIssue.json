        {
            "parameters": {
                "jsCode": "const { repo, from, to } = $('Report Window').first().json;\nconst metrics = [\n  ['Открыто за неделю', $('Opened Issues').first().json],\n  ['Закрыто за неделю', $('Closed Issues').first().json],\n  ['Из новых всё ещё открыто', $('Still Open').first().json],\n  ['Из новых с needs-triage', $('Needs Triage').first().json],\n];\n\nfor (const [name, result] of metrics) {\n  if (result.incomplete_results || !Array.isArray(result.items)) {\n    throw new Error(`Неполный ответ GitHub: ${name}`);\n  }\n}\n\nconst opened = metrics[0][1];\nif (opened.items.length !== opened.total_count) {\n  throw new Error('Для группировки всех новых Issues нужна пагинация.');\n}\n\nconst types = ['bug', 'task', 'feature', 'spam'];\nconst byType = new Map();\nconst byAuthor = new Map();\n\nfor (const issue of opened.items) {\n  const labels = issue.labels.map(label => label.name);\n  const type = labels.includes('needs-triage')\n    ? 'needs-triage'\n    : types.find(name => labels.includes(name)) ?? 'без типа';\n  const author = issue.user?.login ?? 'неизвестен';\n\n  byType.set(type, (byType.get(type) ?? 0) + 1);\n  byAuthor.set(author, (byAuthor.get(author) ?? 0) + 1);\n}\n\nconst escape = value => String(value)\n  .replaceAll('&', '&amp;')\n  .replaceAll('<', '&lt;')\n  .replaceAll('>', '&gt;');\n\nconst table = (heading, rows) =>\n  `<h3>${heading}</h3><table border=\"1\" cellpadding=\"6\" cellspacing=\"0\">` +\n  '<tr><th>Название</th><th>Количество</th></tr>' +\n  rows.map(([name, count]) => `<tr><td>${escape(name)}</td><td>${count}</td></tr>`).join('') +\n  '</table>';\n\nconst counts = Object.fromEntries(metrics.map(([name, result]) => [name, result.total_count]));\n\nreturn [{\n  json: {\n    repo, from, to, counts,\n    byType: Object.fromEntries(byType),\n    byAuthor: Object.fromEntries(byAuthor),\n    subject: `Недельный отчёт по Issues · ${repo}`,\n    html: `<h2>${escape(repo)}</h2><p>${escape(from)} — ${escape(to)} (UTC)</p>` +\n      table('За неделю', Object.entries(counts)) +\n      table('Новые Issues по типам', [...byType]) +\n      table('Новые Issues по авторам', [...byAuthor]),\n  },\n}];"
            },
            "type": "n8n-nodes-base.code",
