{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/practice-local",
  "small_model": "ollama/practice-local",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "itmo-agent": {
          "name": "ITMO local 64k",
          "limit": {
            "context": 65536,
            "output": 4096
          }
        },
        "practice-local": {
          "name": "practice.local 16k",
          "limit": {
            "context": 16384,
            "output": 1024
          }
        }
      }
    }
  },
  "compaction": {
    "auto": false
  },
  "agent": {
    "local-guide": {
      "description": "Read-only local repository assistant",
      "mode": "primary",
      "prompt": "{file:./repo-system.txt}",
      "steps": 8,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    },
    "test-reader": {
      "description": "Test code reader (read-only, demo scope)",
      "model": "ollama/practice-local",
      "prompt": "{file:./repo-system.txt}",
      "steps": 5,
      "permission": {
        "*": "deny",
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "task": "deny",
        "skill": "deny",
        "external_directory": "deny"
      }
    }
  }
}
