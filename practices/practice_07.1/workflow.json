        {
            "parameters": {
                "jsCode": "const pr = $('Get PR JSON').first().json;\nconst files = $input.all().map(item => item.json);\nconst reviewFiles = [];\n\nif (files.length !== pr.changed_files) {\n  throw new Error('GitHub вернул не все изменённые файлы.');\n}\n\nfor (const { filename: path, patch, additions, deletions } of files) {\n  if (!additions && !deletions) continue;\n  if (!patch) throw new Error('GitHub не вернул diff для ' + path);\n\n  let added = 0;\n  let removed = 0;\n  const hunks = [];\n\n  for (const chunk of patch.replace(/\\n$/, '').split(/\\n(?=@@ )/)) {\n    const [header, ...rows] = chunk.split('\\n');\n    const match = /^@@ -(\\d+)(?:,(\\d+))? \\+(\\d+)(?:,(\\d+))? @@/.exec(header);\n    if (!match) throw new Error('Не удалось разобрать diff для ' + path);\n\n    let left = Number(match[1]);\n    let right = Number(match[3]);\n    const leftEnd = left + Number(match[2] ?? 1);\n    const rightEnd = right + Number(match[4] ?? 1);\n\n    const lines = { LEFT: [], RIGHT: [] };\n    const changed = { LEFT: [], RIGHT: [] };\n    const annotated = [header];\n\n    for (const row of rows) {\n      switch (row[0]) {\n        case '+':\n          lines.RIGHT.push(right);\n          changed.RIGHT.push(right);\n          annotated.push('RIGHT ' + right + ' ' + row);\n          right++;\n          added++;\n          break;\n        case '-':\n          lines.LEFT.push(left);\n          changed.LEFT.push(left);\n          annotated.push('LEFT ' + left + ' ' + row);\n          left++;\n          removed++;\n          break;\n        case ' ':\n          lines.RIGHT.push(right);\n          annotated.push('RIGHT ' + right + ' ' + row);\n          left++;\n          right++;\n          break;\n        case '\\\\':\n          break;\n        default:\n          throw new Error('Неизвестная строка diff в ' + path);\n      }\n    }\n\n    if (left !== leftEnd || right !== rightEnd) {\n      throw new Error('Неполный блок diff в ' + path);\n    }\n\n    hunks.push({ diff: annotated.join('\\n'), lines, changed });\n  }\n\n  if (added !== additions || removed !== deletions) {\n    throw new Error('GitHub вернул неполный diff для ' + path);\n  }\n\n  reviewFiles.push({ path, hunks });\n}\n\nif (!reviewFiles.length) throw new Error('Нет текстовых изменений для ревью.');\nreturn [{ json: { files: reviewFiles } }];"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
