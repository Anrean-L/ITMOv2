            "parameters": {
                "jsonSchemaExample": "{\n  \"summary\": \"Проверка пустого списка выполняется слишком поздно.\",\n  \"comments\": [\n    {\n      \"path\": \"src/parser.py\",\n      \"side\": \"RIGHT\",\n      \"startLine\": 45,\n      \"endLine\": 47,\n      \"body\": \"Здесь читается items[0]. Проверка на строке 80 выполняется позже, поэтому пустой список вызовет IndexError.\"\n    }\n  ]\n}"
            },
            "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
            "typeVersion": 1.3,
            "position": [
                736,
                80
            ],
            "id": "aa97e6a2-0307-4027-8ca6-27ee0bd0e11c",
            "name": "Structured Output Parser"
        },
        {
            "parameters": {
                "jsCode": "const { files } = $('Split Diff').first().json;\nconst { head } = $('Get PR JSON').first().json;\nconst { model } = $('Select Model').first().json;\nconst { summary, comments: findings } = $input.first().json.output ?? {};\n\nif (typeof summary !== 'string' || !summary.trim() || !Array.isArray(findings)) {\n  throw new Error('В ответе модели ожидаются summary и массив comments.');\n}\n\nconst filesByPath = new Map(files.map(file => [file.path, file]));\n\nconst comments = findings.map(({ path, side, startLine, endLine, body }) => {\n  if ((side !== 'LEFT' && side !== 'RIGHT') ||\n      !Number.isInteger(startLine) || !Number.isInteger(endLine) ||\n      startLine < 1 || endLine < startLine ||\n      typeof body !== 'string' || !body.trim()) {\n    throw new Error('Некорректное замечание для ' + path);\n  }\n\n  const hunk = filesByPath.get(path)?.hunks.find(({ lines, changed }) =>\n    lines[side].includes(startLine) &&\n    lines[side].includes(endLine) &&\n    changed[side].some(line => line >= startLine && line <= endLine)\n  );\n\n  if (!hunk) {\n    throw new Error('Диапазон вне блока diff: ' + path + ' ' + side + ' ' + startLine + '–' + endLine);\n  }\n\n  const comment = { path, side, line: endLine, body: body.trim() };\n  if (startLine !== endLine) {\n    comment.start_line = startLine;\n    comment.start_side = side;\n  }\n  return comment;\n});\n\nreturn [{\n  json: {\n    commit_id: head.sha,\n    event: 'COMMENT',\n    body: '**TL;DR**\\n\\n' + summary.trim() + '\\n\\n---\\nРевью проведено AI. Модель: ' + model + '.',\n    ...(comments.length ? { comments } : {}),\n  },\n}];"
            },
